
{
  "compilerOptions": {
     "typeRoots": ["./types", "./node_modules/@types"],
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "commonjs",
    "jsx": "react",
    "declaration": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "composite": true,
    "rootDir": "src",
    "outDir": "./"
  },
  "include": [
    "src"
  ],
  "exclude": ["node_modules"]
}



